# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/exam-portal-db

# Portal User Integration
PORTAL_USER_BASE_URL=https://api.example.com/users/api/v1
PORTAL_USER_API_KEY=your_portal_user_api_key
PORTAL_USER_API_SECRET=your_portal_user_api_secret

# App Config
PROJECT_NAME=Examination Portal
API_V1_STR=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173"]

# Session Config
HEARTBEAT_TIMEOUT_SECONDS=60
SESSION_EXPIRY_MINUTES=1440

# Single-Session Enforcement Config (strict exam integrity)
BYPASS_SINGLE_SESSION=false
SESSION_BYPASS_KEY=your_session_bypass_key
AUTO_REVOKE_EXISTING_SESSIONS=false
